{
	"name": "zipwp-images",
	"version": "1.0.26",
	"description": "",
	"main": "index.js",
	"scripts": {
		"start": "wp-scripts start --entry=./assets/src  --output-path=./dist",
		"build": "wp-scripts build --entry=./assets/src --output-path=./dist",
		"i18n": "grunt textdomain && wp i18n make-pot languages/zipwp-images.pot --domain=zipwp-images --debug",
		"pretty": "prettier --check .",
		"pretty:fix": "prettier --write .",
		"lint-js": "wp-scripts lint-js",
		"lint-js:fix": "npm run pretty:fix && npm run lint-js -- --fix",
		"lint-css": "wp-scripts lint-style --allow-empty-input",
		"lint-css:fix": "npm run lint-css -- --fix",
		"lint-pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:md:js": "wp-scripts lint-md-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"plugin-zip": "wp-scripts plugin-zip",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js",
		"package": "sh bin/build.sh",
		"release": "npm run build && npm run package"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brainstormforce/zipwp-images.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/brainstormforce/zipwp-images/issues"
	},
	"homepage": "https://github.com/brainstormforce/zipwp-images#readme",
	"devDependencies": {
		"@wordpress/scripts": "^27.9.0",
		"autoprefixer": "^10.4.19",
		"grunt": "^1.4.1",
		"grunt-bumpup": "^0.6.3",
		"grunt-cli": "^1.4.3",
		"grunt-contrib-clean": "^2.0.0",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-text-replace": "^0.4.0",
		"grunt-wp-i18n": "^1.0.3",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3",
		"webpack-cli": "^5.1.1",
		"wp-prettier": "^2.6.2"
	},
	"dependencies": {
		"@headlessui/react": "^2.0.3",
		"@heroicons/react": "^2.1.3",
		"@popperjs/core": "^2.11.8",
		"@tailwindcss/forms": "^0.5.9",
		"@tippyjs/react": "^4.2.6",
		"@wordpress/api-fetch": "^6.55.0",
		"@wordpress/element": "^5.35.0",
		"@wordpress/i18n": "^4.58.0",
		"clsx": "^2.1.1",
		"react-hook-form": "^7.51.4",
		"react-layout-masonry": "^1.1.0",
		"tailwind-merge": "^2.3.0",
		"zustand": "^4.5.2"
	}
}